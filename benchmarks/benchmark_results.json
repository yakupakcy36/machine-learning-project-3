{
  "project": "Physicochemical Wine Quality & Sensory Grader",
  "dataset": "Vinho Verde Red Wine Physicochemical Cohort (N=1,599, d=11)",
  "validation_scheme": "5-Fold Stratified Cross-Validation",
  "features": [
    "fixed_acidity",
    "volatile_acidity",
    "citric_acid",
    "residual_sugar",
    "chlorides",
    "free_sulfur_dioxide",
    "total_sulfur_dioxide",
    "density",
    "pH",
    "sulphates",
    "alcohol_pct_vol"
  ],
  "results": [
