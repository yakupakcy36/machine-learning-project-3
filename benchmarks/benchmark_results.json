      "roc_auc": 0.9552
    },
    {
      "model": "HistGradientBoosting",
      "accuracy": 0.93,
      "precision": 0.9016,
      "recall": 0.7703,
      "f1": 0.8308,
      "roc_auc": 0.9507
    },
    {
      "model": "Random Forest (200 Trees)",
      "accuracy": 0.9168,
      "precision": 0.9118,
      "recall": 0.6947,
      "f1": 0.7886,
      "roc_auc": 0.9467
    }
  ]
